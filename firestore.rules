rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /stores/{storeId} {
      // Anyone can read store profiles — needed for the public directory
      // and public storefronts (customers aren't logged in).
      allow read: if true;

      // A seller can only create/edit their OWN store document (doc id ==
      // their Firebase Auth uid). The Super Admin account can edit any
      // store — that's how plan activation / blocking / trial extension
      // works. Update this email if you ever change the Super Admin login.
      allow create: if request.auth != null
        && request.auth.uid == storeId
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null &&
        (
          request.auth.token.email == "sumitart2018@gmail.com" ||
          (
            request.auth.uid == storeId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name", "tagline", "whatsapp", "color", "theme",
              "minOrderValue", "freeShippingThreshold", "shippingFee", "gstPercent",
              "paymentMethod", "upiId",
              "categories", "ownerName", "altPhone", "address", "gstin", "about",
              "facebook", "instagram", "youtube", "bannerImg", "logoImg",
              "seoTitle", "seoDescription"
            ])
          )
        )
        // Public storefront views can only increase the counter by exactly
        // one. This prevents a visitor from overwriting the store profile or
        // setting an arbitrary visitor total from the browser.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visitorCount"])
          && (
            (!resource.data.keys().hasAny(["visitorCount"]) && request.resource.data.visitorCount == 1)
            || (resource.data.keys().hasAny(["visitorCount"]) && request.resource.data.visitorCount == resource.data.visitorCount + 1)
          )
        );
      allow delete: if false;

      match /products/{productId} {
        // Public storefronts need to read products without logging in.
        allow read: if true;
        // Only that store's own owner can add/edit/delete their products.
        allow create: if request.auth != null
          && request.auth.uid == storeId
          && request.resource.data.storeId == storeId;
        allow update: if request.auth != null
          && request.auth.uid == storeId
          && resource.data.storeId == storeId
          && request.resource.data.storeId == storeId;
        // Anonymous checkout can reduce tracked stock only inside the same
        // atomic transaction that creates the matching order. getAfter()
        // prevents a random browser update from increasing or resetting stock.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stockQty", "inStock", "lastStockOrderId"])
          && resource.data.trackInventory == true
          && request.resource.data.trackInventory == true
          && request.resource.data.stockQty is number
          && request.resource.data.stockQty >= 0
          && request.resource.data.stockQty < resource.data.stockQty
          && request.resource.data.inStock == (request.resource.data.stockQty > 0)
          && request.resource.data.lastStockOrderId is string
          && getAfter(/databases/$(database)/documents/stores/$(storeId)/orders/$(request.resource.data.lastStockOrderId)).data.storeId == storeId
          && getAfter(/databases/$(database)/documents/stores/$(storeId)/orders/$(request.resource.data.lastStockOrderId)).data.stockAdjustments[productId] is number
          && request.resource.data.stockQty == resource.data.stockQty - getAfter(/databases/$(database)/documents/stores/$(storeId)/orders/$(request.resource.data.lastStockOrderId)).data.stockAdjustments[productId];
        allow delete: if request.auth != null && request.auth.uid == storeId;
      }

      match /orders/{orderId} {
        // Checkout is anonymous (customers never log in), but the payload is
        // validated before it is stored. Only the store owner can read an
        // order or change its status.
        allow create: if request.resource.data.storeId == storeId
          && request.resource.data.status == "New"
          && request.resource.data.date is string
          && request.resource.data.customer is map
          && request.resource.data.customer.name is string
          && request.resource.data.customer.name.size() > 0
          && request.resource.data.customer.name.size() <= 120
          && request.resource.data.customer.phone is string
          && request.resource.data.customer.phone.size() >= 10
           && request.resource.data.customer.phone.size() <= 20
           && request.resource.data.items is list
           && request.resource.data.items.size() > 0
           && request.resource.data.items.size() <= 50
           && request.resource.data.total is number
           && request.resource.data.total >= 0
           && request.resource.data.paymentMethod in ["whatsapp", "upi", "razorpay"]
           && request.resource.data.paymentStatus in ["unpaid", "pending", "paid", "failed", "refunded"];
        allow read: if request.auth != null && request.auth.uid == storeId;
        allow update: if request.auth != null
          && request.auth.uid == storeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && request.resource.data.status in ["New", "Confirmed", "Shipped", "Delivered", "Cancelled"];
        allow update: if request.auth != null
          && request.auth.uid == storeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus"])
          && request.resource.data.paymentStatus in ["unpaid", "pending", "paid", "failed", "refunded"];
        allow delete: if false;
      }

      // Public engagement counters. These counters are intentionally
      // append-by-one only; sellers can read them, but no browser can replace
      // the summary with an arbitrary number.
      match /analytics/{analyticsId} {
        allow read: if request.auth != null && request.auth.uid == storeId && analyticsId == "summary";
        allow create: if analyticsId == "summary"
          && request.resource.data.keys().hasOnly(["productViews", "addToCart"])
          && request.resource.data.productViews is number
          && request.resource.data.addToCart is number
          && ((request.resource.data.productViews == 1 && request.resource.data.addToCart == 0)
            || (request.resource.data.productViews == 0 && request.resource.data.addToCart == 1));
        allow update: if analyticsId == "summary"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["productViews", "addToCart"])
          && ((request.resource.data.productViews == resource.data.productViews + 1
            && request.resource.data.addToCart == resource.data.addToCart)
            || (request.resource.data.addToCart == resource.data.addToCart + 1
            && request.resource.data.productViews == resource.data.productViews));

        match /products/{productId} {
          allow read: if request.auth != null && request.auth.uid == storeId;
          allow create: if request.resource.data.keys().hasOnly(["productId", "name", "views", "addToCart"])
            && request.resource.data.productId == productId
            && request.resource.data.name is string
            && request.resource.data.views is number
            && request.resource.data.addToCart is number
            && ((request.resource.data.views == 1 && request.resource.data.addToCart == 0)
              || (request.resource.data.views == 0 && request.resource.data.addToCart == 1));
          allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "views", "addToCart"])
            && request.resource.data.productId == resource.data.productId
            && ((request.resource.data.views == resource.data.views + 1
              && request.resource.data.addToCart == resource.data.addToCart)
              || (request.resource.data.addToCart == resource.data.addToCart + 1
              && request.resource.data.views == resource.data.views));
          allow delete: if false;
        }
      }

      match /reviews/{reviewId} {
        // Anyone can submit feedback, but it always starts as pending and is
        // never visible publicly until the store owner approves it.
        allow create: if request.resource.data.storeId == storeId
          && request.resource.data.status == "pending"
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() > 0
          && request.resource.data.customerName.size() <= 80
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 600;
        allow read: if (request.auth != null && request.auth.uid == storeId)
          || resource.data.status == "approved";
        allow update: if request.auth != null
          && request.auth.uid == storeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "ownerReply"])
          && request.resource.data.status in ["pending", "approved", "hidden"];
        allow delete: if request.auth != null && request.auth.uid == storeId;
      }
    }

    // The homepage loads public products with a collection-group query.
    // Orders intentionally have no collection-group read rule: only the
    // owning store may read its own orders through the nested rule above.
    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    // One public, append-by-one counter for visits to the main SaaS homepage.
    // The client only writes an increment; no visitor identity is stored.
    match /analytics/{analyticsId} {
      allow read: if analyticsId == "platform";
      allow create: if analyticsId == "platform"
        && request.resource.data.keys().hasOnly(["visitorCount"])
        && request.resource.data.visitorCount == 1;
      allow update: if analyticsId == "platform"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visitorCount"])
        && request.resource.data.visitorCount == resource.data.visitorCount + 1;
      allow delete: if false;
    }
  }
}
