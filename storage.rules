rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images live under /{storeId}/... — public read (storefronts and the
    // directory need to display them without anyone being logged in),
    // write only by that store's own authenticated owner.
    match /{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == storeId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
