# Copy this file to .env and fill in your own Firebase project's values.
# Get these from: Firebase Console → Project Settings → General → "Your apps" → SDK setup and configuration
# (Vite requires the VITE_ prefix on env vars to expose them to the browser.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay server-side keys — VITE_ prefix mat lagana; inhe sirf Vercel
# Environment Variables mein add karo, GitHub/browser code mein kabhi nahi.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Firebase service-account JSON, sirf Razorpay payment verification API ke liye.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Server-only base32 secret for the Super Admin Google Authenticator step-up.
# Add it in Vercel as a Secret for Production/Preview; never use a VITE_ prefix.
ADMIN_SUPPORT_TOTP_SECRET=
