# Copy this file to .env and fill in your own Firebase project's values.
# Get these from: Firebase Console → Project Settings → General → "Your apps" → SDK setup and configuration
# (Vite requires the VITE_ prefix on env vars to expose them to the browser.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
